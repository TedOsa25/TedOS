# ============================================================================
# HeyAudit — E-Mail-/Versand-Infrastruktur (IONOS SMTP)
# ----------------------------------------------------------------------------
# Dieselbe Engine wie HeyCarbo — nur Domain, Absender und Provider-Zugang sind
# HeyAudit-/IONOS-spezifisch. Kopieren als .env, echte Werte eintragen, laden
# (z. B. `set -a; . ./.env; set +a`). KEINE echten Passwörter committen.
#
# Absender/Reply-To/BCC = ted@heyaudit.de kommen bereits aus dem Brand-Profil
# (REVENUE_BRAND=heyaudit); die Zeilen unten machen sie nur explizit/überschreibbar.
# ============================================================================

# --- Brand-Profil: wählt HeyAudit (Absender, BCC, URLs, Copy, Lead-Quelle) ---
REVENUE_BRAND=heyaudit

# --- Provider + Master-Switch (Sicherheitsgates) ----------------------------
REVENUE_EMAIL_PROVIDER=smtp          # IONOS SMTP als Versandprovider
REVENUE_SEND_ENABLED=0               # MASTER SWITCH: 0 = Dry-Run, 1 = scharf. Default 0.

# --- IONOS SMTP-Zugang ------------------------------------------------------
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465                        # 465 = SSL (SMTP_SECURE=1) · 587 = STARTTLS (SMTP_SECURE=0)
SMTP_SECURE=1
SMTP_USER=ted@heyaudit.de            # (Anfrage: SMTP_USERNAME)
SMTP_PASS=                           # (Anfrage: SMTP_PASSWORD) — IONOS-Postfachpasswort, NICHT committen

# --- Absenderidentität (Default aus Brand-Profil, hier explizit) ------------
REVENUE_FROM_EMAIL=ted@heyaudit.de   # (Anfrage: MAIL_FROM)
REVENUE_FROM_NAME=Ted
REVENUE_REPLY_TO=ted@heyaudit.de     # (Anfrage: MAIL_REPLY_TO)
REVENUE_BCC_FIRST_BATCH=ted@heyaudit.de  # (Anfrage: MAIL_BCC) — blinde Monitoring-Kopie, nur Batch 1

# --- Batch-Versand ----------------------------------------------------------
REVENUE_BATCH_SIZE=20                # (Anfrage: REVENUE_BATCH_SIZE)

# --- Preflight (DNS-Checks für heyaudit.de) ---------------------------------
REVENUE_DKIM_SELECTOR=s1-ionos       # IONOS DKIM-Selector (bereits Default)

# --- Optionale Overrides (sonst Default aus Brand-Profil) -------------------
# REVENUE_ACCOUNTS_PATH=../../../Sales/crm-heyaudit/leads.js
# REVENUE_CALENDLY_URL=https://calendly.com/ted-heyaudit/30min
# TEDOS_STORAGE_PATH=./.revenue-state   # persistenter Store (Approval-UI + Batch-Send teilen ihn)

# ----------------------------------------------------------------------------
# Namens-Mapping (Anfrage → tatsächliche Engine-Variable, identisch zu HeyCarbo):
#   SMTP_USERNAME   → SMTP_USER          MAIL_FROM      → REVENUE_FROM_EMAIL
#   SMTP_PASSWORD   → SMTP_PASS          MAIL_REPLY_TO  → REVENUE_REPLY_TO
#   MASTER_SWITCH   → REVENUE_SEND_ENABLED   MAIL_BCC   → REVENUE_BCC_FIRST_BATCH
#   APPROVAL_ENABLED→ immer aktiv: Provider "revenue-center" = manuelle Freigabe;
#                     scharfer Versand erst mit REVENUE_SEND_ENABLED=1 + approved Leads.
# ----------------------------------------------------------------------------
